{
    "manifest_version":  3,
    "name":  "BSC DLP Browser Guard",
    "version":  "0.6.6.3",
    "description":  "Local-first browser DLP with outgoing text, generic file upload and Browser Guard presence monitoring.",
    "permissions":  [
                        "storage",
                        "alarms"
                    ],
    "host_permissions":  [
                             "http://127.0.0.1:8765/*"
                         ],
    "background":  {
                       "service_worker":  "service-worker.js"
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "http://*/*",
                                                "https://*/*"
                                            ],
                                "js":  [
                                           "content.js"
                                       ],
                                "run_at":  "document_idle"
                            }
                        ],
    "action":  {
                   "default_title":  "BSC DLP Browser Guard"
               }
}