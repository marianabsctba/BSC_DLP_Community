{
  "manifest_version": 3,
  "name": "BSC DLP Browser Guard",
  "version": "0.6.4",
  "description": "Local-first browser DLP protection for outgoing sensitive content.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "BSC DLP Browser Guard"
  }
}
